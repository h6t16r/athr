# ===== قاعدة البيانات (Supabase > Project Settings > Database) =====
# رابط الاتصال المجمّع (Transaction pooler - المنفذ 6543)
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# رابط الاتصال المباشر (المنفذ 5432) - يستخدم لإنشاء الجداول
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres"

# ===== تخزين الصور (Supabase > Storage) =====
SUPABASE_URL="https://xxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="ضع مفتاح service_role هنا (سري - لا تشاركه)"
# صور المتوفين المنشورة (Bucket عام Public)
SUPABASE_PUBLIC_BUCKET="deceased"
# صور طلبات الأسر قيد المراجعة (Bucket خاص Private)
SUPABASE_PRIVATE_BUCKET="submissions"

# ===== الأمان =====
# سر طويل عشوائي (32 حرفًا أو أكثر) لتوقيع جلسات الإدارة
AUTH_SECRET="ضع_هنا_نصا_عشوائيا_طويلا_جدا_32_حرف_على_الاقل"
# رمز التهيئة لمرة واحدة (24 حرفًا أو أكثر) - يعمل فقط قبل إنشاء أي حساب إداري
SETUP_TOKEN="ضع_رمزا_عشوائيا_طويلا_24_حرف_على_الاقل"

# ===== الحسابات الإدارية الثلاثة (تُنشأ مرة واحدة فقط) =====
# كلمة المرور 12 حرفًا على الأقل
ADMIN1_USERNAME="admin"
ADMIN1_NAME="المشرف الرئيسي"
ADMIN1_PASSWORD=""
ADMIN2_USERNAME="admin2"
ADMIN2_NAME="مشرف ثان"
ADMIN2_PASSWORD=""
ADMIN3_USERNAME="admin3"
ADMIN3_NAME="مشرف ثالث"
ADMIN3_PASSWORD=""

# اختياري: true لإضافة بيانات تجريبية وهمية واضحة أثناء التطوير فقط
SEED_DEMO="false"

# رابط الموقع النهائي (بدون / في النهاية)
NEXT_PUBLIC_SITE_URL="https://your-site.netlify.app"
